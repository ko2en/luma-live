# LUMA Live + nginx 反代示例
#
# 放到 /etc/nginx/sites-available/luma-live 后：
#   ln -s /etc/nginx/sites-available/luma-live /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# 证书用 certbot 也好、Cloudflare 也好，只要能给 443 配上证书即可。
# 下面的 80 段只做跳转；如果证书由 Cloudflare 终结（Flexible），
# 就把 443 段删掉，改成 80 直接反代，并让服务端 TRUST_PROXY=1。

upstream luma_live {
    server 127.0.0.1:3000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name luma.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name luma.example.com;

    ssl_certificate     /etc/letsencrypt/live/luma.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/luma.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 头像上传：服务端本身限 512KB，这里给点余量即可
    client_max_body_size 8m;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection        "";

    # SSE：聊天与房间状态走长连接，必须关缓冲、拉长超时
    location = /api/events {
        proxy_pass http://luma_live;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        chunked_transfer_encoding on;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 健康检查可以直接放行给探针，不需要登录
    location = /healthz {
        proxy_pass http://luma_live;
        access_log off;
    }

    location / {
        proxy_pass http://luma_live;
        proxy_read_timeout 60s;
    }
}

# 注意：
# 1) 反代之后所有请求的来源都是 127.0.0.1，服务端要设 TRUST_PROXY=1，
#    否则登录失败限速会把全站算成同一个 IP。
# 2) 源站只监听 127.0.0.1，或者用防火墙挡住 3000，别让外面绕过反代直连。
